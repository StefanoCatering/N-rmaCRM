# ── Servidor ─────────────────────────────────────────────────────
PORT=8765
NODE_ENV=development

# Clave para firmar las cookies de sesión.
# En producción usá una cadena larga y aleatoria (mínimo 32 caracteres).
SESSION_SECRET=cambiar-por-una-clave-secreta-larga

# ── Base de datos (Supabase / PostgreSQL) ─────────────────────────
# Encontrás estos valores en: Supabase Dashboard → Settings → Database
DB_HOST=db.<tu-project-id>.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=<tu-password>
DB_PORT=5432
