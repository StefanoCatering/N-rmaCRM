# ── Servidor ─────────────────────────────────────────────────────
PORT=8765
NODE_ENV=development

# Clave para firmar los JWT de autenticación.
# Generá un string aleatorio largo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# En Vercel: Settings → Environment Variables → JWT_SECRET
JWT_SECRET=cambiar-por-una-clave-secreta-larga-minimo-32-chars

# ── Base de datos (Supabase / PostgreSQL) ─────────────────────────
# Los valores exactos están en: Supabase Dashboard → Settings → Database
#
# OPCIÓN A — Conexión directa (para desarrollo local)
# DB_HOST=db.<project-ref>.supabase.co
# DB_USER=postgres
# DB_PORT=5432
#
# OPCIÓN B — Pooler (para producción / Vercel — recomendado)
# El pooler de Supabase requiere que DB_USER incluya el project-ref
# en formato postgres.<project-ref> para identificar el tenant.
# DB_HOST=aws-0-us-east-1.pooler.supabase.com   # región puede variar
# DB_USER=postgres.<project-ref>                 # ej: postgres.bjnwremoaooglpxrnzgi
# DB_PORT=6543
#
DB_HOST=db.<project-ref>.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=<tu-password>
DB_PORT=5432

# ── Base de Narma Pedidos (sync de órdenes de producción) ──────────
# SEGUNDA base, distinta de la del CRM: es el proyecto Supabase narma-pedidos
# (ref rgppcvqoephcjjcnqwnz), donde vive la tabla pedidos_crm_detalle.
#
# Dónde sacarla: Supabase Dashboard → proyecto narma-pedidos → Connect →
# "Connection string" → pestaña Transaction pooler → URI. Copiás esa URI y
# reemplazás [YOUR-PASSWORD] por la contraseña de la base de ese proyecto.
#
# Usá el POOLER (puerto 6543), no la conexión directa: el CRM corre como
# función serverless en Vercel y la conexión directa se queda sin slots.
# El formato queda así (el usuario incluye el project-ref, igual que arriba):
#
#   postgresql://postgres.rgppcvqoephcjjcnqwnz:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
#
# Si esta variable NO está configurada, el CRM funciona igual: los pedidos se
# guardan normalmente y cada intento de sync queda anotado en la tabla
# sync_errores para reenviarlo después (se avisa por consola al arrancar).
#
# En Vercel: Settings → Environment Variables → PEDIDOS_DATABASE_URL
PEDIDOS_DATABASE_URL=
